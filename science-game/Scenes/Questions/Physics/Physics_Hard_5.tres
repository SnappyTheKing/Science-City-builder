script = ExtResource("1_6tx62")
question = "Given that the speed of light in crown glass is 1.97 x10^8 m/s, what is the angle of refraction (to the nearest degree) of a ray of light which is travelling from water into crown glass at an angle of incidence of 30 deg?"
answers = Array[String](["~26 deg", "~24 deg", "~33 deg", "~36 deg"])
